# deploy.env: the host's settings for ovs.sh, copied to ../.env (beside ovs.sh) and edited. No secrets here: those
# go in OVS_ENV_DIR (services.env, relay.env, mongo.env, redis.conf). ovs.sh passes this file to both Compose projects.

# The Compose project names: <project> for the services, <project>-dbs for the stores. Two stacks on one host (a
# testing one beside prod, say) need different names; their volumes and containers are named after them.
OVS_PROJECT=openversus

# The stores' network: the dbs project creates it; the services join it. Set it to an existing network to use stores
# that already run there instead (then point MONGODB_URI and REDIS in services.env at them and skip `ovs.sh up dbs`).
OVS_NETWORK=ovs

# Host directories (ovs.sh setup creates them, owned by OVS_UID:OVS_GID when run as root).
OVS_ENV_DIR=/etc/openversus
OVS_DATA_DIR=/var/lib/openversus/data
OVS_KEYS_DIR=/var/lib/openversus/keys
OVS_RUN_DIR=/run/openversus
OVS_LOG_DIR=/var/log/openversus

# The host user the services run as (owner of the directories above).
OVS_UID=1654
OVS_GID=1654

# Public ports: the game's HTTP API (the router) and its websocket (the edge, = Realtime:Port in services.env), and the
# relay's and rendezvous's UDP ports (host network). Another stack on the host needs other numbers.
OVS_GAME_PORT=8000
OVS_EDGE_PORT=3001
OVS_RELAY_PORT=41234
OVS_RENDEZVOUS_PORT=41235

# REQUIRED: this host's public address, handed to P2P nodes as the relay to fall back to.
OVS_RELAY_ADDRESS=

# The image tags: images.env (written by build.sh into the bundle) sets them; set them here only to override.
#OVS_TAG=
#OVS_RELAY_TAG=
