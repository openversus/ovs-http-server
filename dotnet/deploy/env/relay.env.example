# relay.env: the rollback relay (the ovs-rollback-server repository). It reports match status to the server at
# Server__BaseUrl with Server__MatchUpdateKey (MATCHUPDATEKEY in services.env); the port is the container's argument.
Server__BaseUrl=http://127.0.0.1:8000
OVS_SERVER=http://127.0.0.1:8000
Server__MatchUpdateKey=change-me
