# services.env: what every C# service reads. Copy to $OVS_ENV_DIR/services.env and fill in; never commit the copy.
# Settings use the configuration key form (Section__Key); the TS-era names (REDIS, MONGODB_URI, JWT_SECRET, ...) are
# read too. A setting marked "hot" can also be changed while running (ovsctl settings set), and the stored value then
# wins over this file; what is here is what a fresh store starts from.

# Stores (the dbs project's service names on the ovs network)
REDIS=redis
REDIS_PORT=6379
REDIS_USERNAME=ovs
REDIS_PW=change-me
# The path is the database: a host that ran the TS server holds its data in `test`, so name that one to keep it.
MONGODB_URI=mongodb://ovs:change-me@mongo:27017/openversus?authSource=admin

# The public face: what the game is told to connect to
GAME_DOMAIN=play.example.org
WB_DOMAIN=play.example.org
# The edge's host port (OVS_EDGE_PORT in the Compose project); hot. Secure is 0 or 1 (USE_SECURE_WEBSOCKET), as the TS server had it.
Realtime__Port=3001
Realtime__Secure=0

# Secrets shared between services
JWT_SECRET=change-me-long-random
Access__IdentifySecret=change-me-long-random-different
Gateway__EdgeSecret=change-me-long-random-different-again
MATCHUPDATEKEY=change-me
# The website's admin pages (?pw= once) and the bearer token POST /syncAsset must carry (empty refuses every sync)
ADMIN_PASSWORD=change-me
DATA_ASSET_TOKEN=change-me

# Platform identity
STEAM_APP_ID=1818750
Steam__Enabled=true
# The game's Epic client id is the default; set it empty to leave Epic ids as unverified claims; hot.
#Epic__ClientId=

# Ranked: the rating a new player, and a character with no rating of its own, starts from; the rating arithmetic (K
# past and during a player's provisional sets in a mode, how many sets that is, and the divisor); all hot
DEFAULT_ELO=1000
K_1V1=32
K_2V2=32
K_PROVISIONAL=64
PROVISIONAL_GAME_THRESHOLD=20
ELO_DIVISOR=800

# Lobbies: the address a player on this machine (127.0.0.1) is given to the matchmaker as
LOCAL_PUBLIC_IP=203.0.113.10

# Rollback: the relay (UDP on this host) and P2P
P2P_ROLLBACK=true
UDP_SERVER_IP=203.0.113.10
UDP_PORT=41234
P2P_NODE_PORT=41234
OVS_SERVER=http://play.example.org:8000
# The node config signing key pair, mounted at /keys (OVS_KEYS_DIR)
P2P_NODE_SIGNING_KEY_FILE=/keys/node-config-signing-key.pem
P2P_NODE_PUBLIC_KEY=/keys/node-config-public-key.txt

# Data files, mounted read-only at /data (OVS_DATA_DIR): the ban files and the yaml name lists
Bans__IpFile=/data/bans.txt
Bans__CidrFile=/data/cidr_bans.txt
Bans__HardwareFile=/data/hashbans.txt
Bans__SteamIdFile=/data/steamid_bans.txt
Bans__EpicIdFile=/data/epicid_bans.txt
Bans__InstallIdFile=/data/installid_bans.txt
Bans__AutoBansFile=/data/auto_bans.yaml
Bans__BannedNamesFile=/data/banned_names.yaml
Bans__ForceChangeNamesFile=/data/force_change_names.yaml
Bans__AllowedNamesFile=/data/allowed_names.yaml

# Clients
MIN_CLIENT_VERSION=2026.09.27.1
CLIENT_RELEASE_REPO=openversus/ovs-client
GAME_VERSION=

# Logging: the console (docker logs) always; this adds a daily file per service in the openversus_logs volume
Serilog__WriteTo__0__Name=File
Serilog__WriteTo__0__Args__rollingInterval=Day
Serilog__WriteTo__0__Args__retainedFileCountLimit=14
Serilog__WriteTo__0__Args__outputTemplate=[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}
Log__Level=Information

# Names a TS server's .env had that nothing here reads (a copied .env may keep them; they do nothing):
#   UDP_SERVER_IP2 (always UDP_SERVER_IP), USE_INTERNAL_ROLLBACK, EMULATE_P2 (the TS built-in UDP game),
#     WEBHOOK_DESTROY_PATH (never called: a deployed server ends itself), VERBOSE_LOGGING (Log__Level instead),
#     BANNED_NAMES_FILE and FORCE_CHANGE_NAMES_FILE (the .txt lists; the yaml ones above replace them), OVS_PUBLIC_IP
#     (only a variable the TS .env built other values from), HTTP_PORT (the http service's port, 8000 by default)
#   ON_DEMAND_ROLLBACK, ON_DEMAND_ROLLBACK_PORT_LOW/HIGH, ROLLBACK_UDP_PORT_LOW/HIGH, WEBHOOK_HOST, WEBHOOK_PORT,
#     WEBHOOK_DEPLOY_PATH, WEBHOOK_HMAC_SECRET: a rollback server deployed per match through a webhook, which the relay
#     and P2P replace. These ARE still read when set: leave ON_DEMAND_ROLLBACK out (a copied ON_DEMAND_ROLLBACK=1 turns
#     the per-match deploys back on)
