<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The game's login and sessions: its own executable and image, so a login fix never restarts anything else and
       the rest never restarts login. -->
  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVersus.Server.Core\OpenVersus.Server.Core.csproj" />
    <!-- The Epic ID token verifier: the login judges the Epic credential the game's own request carries (PostAccess). -->
    <ProjectReference Include="..\OpenVersus.Server.Identity\OpenVersus.Server.Identity.csproj" />
    <ProjectReference Include="..\OpenVersus.Server.Http.Shared\OpenVersus.Server.Http.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenVersus.Server.Access.Tests" />
  </ItemGroup>

</Project>
