<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every OpenVersus service shares: settings (changeable while running, cluster-wide through Redis),
       logging, the control API the CLI talks to, and the host setup. Each service is its own host project that
       references this and adds what only it does. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from the TS server's literals by tools/access/gen_templates.mjs. -->
    <EmbeddedResource Include="Access/login-response.json" LogicalName="OpenVersus.Server.Core.Access.login-response.json" />
    <EmbeddedResource Include="Access/sessions-auth-token.json" LogicalName="OpenVersus.Server.Core.Access.sessions-auth-token.json" />
    <EmbeddedResource Include="Static/*.json" LogicalName="OpenVersus.Server.Core.Static.%(Filename)%(Extension)" />
    <EmbeddedResource Include="FileStorage/*.json" LogicalName="OpenVersus.Server.Core.FileStorage.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Inventory/*.json" LogicalName="OpenVersus.Server.Core.Inventory.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenVersus.Server.Core.Tests" />
  </ItemGroup>

</Project>
