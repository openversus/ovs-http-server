<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every OpenVersus service shares: settings (changeable while running, cluster-wide through Redis),
       logging, the control API the CLI talks to, and the host setup. Each service is its own host project that
       references this and adds what only it does. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <!-- The name lists and the auto-ban record file (Bans/). -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- hiss_amalgamation's zstd sections (HissZstd); the same package and version as the client's decoder. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from the TS server's literals by tools/access/gen_templates.mjs. -->
    <EmbeddedResource Include="Access/login-response.json" LogicalName="OpenVersus.Server.Core.Access.login-response.json" />
    <EmbeddedResource Include="Access/sessions-auth-token.json" LogicalName="OpenVersus.Server.Core.Access.sessions-auth-token.json" />
    <EmbeddedResource Include="Static/*.json" LogicalName="OpenVersus.Server.Core.Static.%(Filename)%(Extension)" />
    <EmbeddedResource Include="FileStorage/*.json" LogicalName="OpenVersus.Server.Core.FileStorage.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Inventory/*.json" LogicalName="OpenVersus.Server.Core.Inventory.%(Filename)%(Extension)" />
    <!-- A copy of the TS server's src/data/node-config.json (the image's build context is dotnet/ alone); NodeConfigTests
         fails when the two differ, so both servers hand P2P nodes the same settings update by default. -->
    <EmbeddedResource Include="Matches/node-config.json" LogicalName="OpenVersus.Server.Core.Matches.node-config.json" />
    <!-- Which fighter each stat tracker bundle counts for (AssociatedCharacter): tools/matches/stat_tracker_characters.mjs. -->
    <EmbeddedResource Include="Matches/stat-tracker-characters.json" LogicalName="OpenVersus.Server.Core.Matches.stat-tracker-characters.json" />
    <!-- Copies of the TS server's src/data/pki/<name>/node-config-public-key.txt (NodeConfigTests keeps them equal). -->
    <EmbeddedResource Include="Matches/pki/**/node-config-public-key.txt" LogicalName="OpenVersus.Server.Core.Matches.pki/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Calendar/*.json" LogicalName="OpenVersus.Server.Core.Calendar.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Cosmetics/*.json" LogicalName="OpenVersus.Server.Core.Cosmetics.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Hiss/*.json" LogicalName="OpenVersus.Server.Core.Hiss.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Rifts/*.json" LogicalName="OpenVersus.Server.Core.Rifts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Seasons/*.json" LogicalName="OpenVersus.Server.Core.Seasons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="FunFacts/*.json" LogicalName="OpenVersus.Server.Core.FunFacts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Missions/*.json" LogicalName="OpenVersus.Server.Core.Missions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="RewardTracks/*.json" LogicalName="OpenVersus.Server.Core.RewardTracks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="CustomLobbies/*.json" LogicalName="OpenVersus.Server.Core.CustomLobbies.%(Filename)%(Extension)" />
    <!-- Which service answers each route (RouteOwners): generated by tools/routes/gen_routes.py. -->
    <EmbeddedResource Include="../../docs/routes.json" Link="Hosting/routes.json" LogicalName="OpenVersus.Server.Core.routes.json" />
    <EmbeddedResource Include="Matchmaking/*.json" LogicalName="OpenVersus.Server.Core.Matchmaking.%(Filename)%(Extension)" />
    <EmbeddedResource Include="CustomLobbies/Scripts/*.lua" LogicalName="OpenVersus.Server.Core.CustomLobbies.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenVersus.Server.Core.Tests" />
    <!-- The identify service (the OpenVersus client's registration, Steam tickets) lives next to Core. -->
    <InternalsVisibleTo Include="OpenVersus.Server.Identity" />
  </ItemGroup>

</Project>
