<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every service that answers the game's HTTP shares: the Hydra method override and bodies, the session token
       check, the client gate, the gameplay preferences recorder, the stub and endpoint bases and the request pipeline (GameHttpHost).
       Each service keeps its own endpoints; this holds none. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
  </ItemGroup>

  <!-- The implicit usings of the web SDK, which the moved files were written against. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVersus.Server.Core\OpenVersus.Server.Core.csproj" />
  </ItemGroup>

</Project>
